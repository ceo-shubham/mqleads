# ============================================================================
# MQLeads — environment variables
# Copy this file to `.env.local` and fill in the values you have.
# Nothing works without MONGODB_URI + APP_SECRET. Everything else is optional —
# the UI shows a "keys missing" state until you add them.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# MongoDB Atlas free tier connection string
# https://www.mongodb.com/docs/atlas/getting-started/  (create a free M0 cluster)
MONGODB_URI=mongodb+srv://<db_username>:UeqbnPvo1SdnJuIU@mqleads.fciqele.mongodb.net/?appName=mqleads

# Secret used to sign session cookies AND encrypt OAuth tokens (AES-256-GCM).
# Generate one:  openssl rand -hex 32   (or:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_SECRET=

# Public URL of this app (used by the callback redirect + tracking snippet).
# Leave empty on Vercel (derived automatically); set locally, e.g. http://localhost:3000
APP_URL=

# ---------------------------------------------------------------------------
# SOCIAL / LEAD SOURCE CONNECTIONS (OAuth)
# Each pair enables one "Connect" button in Sources.
# ---------------------------------------------------------------------------

# 1) LinkedIn — https://www.linkedin.com/developers/
#    Create an app → OAuth 2.0. Redirect URI:
#    https://<your-app>/api/sources/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# 2) Instagram + 3) Facebook — https://developers.facebook.com/apps/
#    One Meta app serves both. Add "Instagram" and "Facebook Login" products.
#    Redirect URIs:
#    https://<your-app>/api/sources/instagram/callback
#    https://<your-app>/api/sources/facebook/callback
META_CLIENT_ID=
META_CLIENT_SECRET=

# 4) X / Twitter — https://developer.x.com/ (OAuth 2.0, PKCE enabled)
#    App type: Web App. Redirect URI:
#    https://<your-app>/api/sources/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# 5) YouTube — https://console.cloud.google.com/apis/credentials
#    Enable "YouTube Data API v3" + "Google Search Console API" (same client
#    works for YouTube, Search Console and CSE autofill).
#    Redirect URIs:
#    https://<your-app>/api/sources/youtube/callback
#    https://<your-app>/api/sources/search-console/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6) Reddit — https://www.reddit.com/prefs/apps  ("web app" type)
#    Redirect URI:
#    https://<your-app>/api/sources/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GOOGLE — auto-fill company info + competitor enrichment
# ---------------------------------------------------------------------------
# Programmable Search Engine JSON API (free: 100 queries/day)
#   1. https://programmablesearchengine.google.com/ → create engine, "Search the
#      entire web" → get the search engine ID (cx).
#   2. https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#      → enable API → create API key.
# Without these, company autofill only works when you type a domain.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ---------------------------------------------------------------------------
# BACKBLAZE B2 — file storage (optional; used for logo uploads)
# ---------------------------------------------------------------------------
# https://secure.backblaze.com/b2_buckets.htm → create a bucket, set its
# capability to "Public" if you want direct URLs (B2_PUBLIC_URL).
# Generate an application key with Read & Write access to that bucket.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com
# Optional: full public bucket URL, e.g. https://mqleads-files.s3.us-west-000.backblazeb2.com
B2_PUBLIC_URL=
B2_REGION=us-west-000
